/* Profile Page Styles */

.page-profile {
  padding: 0 24rpx 48rpx;
  background-color: #f5f6fa;
  min-height: 100vh;
}

/* Header */
.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 36rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 0 0 32rpx 32rpx;
  margin: 0 -24rpx 24rpx;
}

.profile-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  margin-bottom: 20rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.profile-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.profile-nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.profile-city {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.profile-completion {
  width: 100%;
  max-width: 480rpx;
}

.completion-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-bottom: 12rpx;
  display: block;
  text-align: center;
}

.progress-bar-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background-color: rgba(255, 255, 255, 0.25);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background-color: #ffffff;
  border-radius: 6rpx;
  transition: width 0.4s ease;
}

.progress-text {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 500;
  min-width: 60rpx;
  text-align: right;
}

/* Cards */
.card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f5;
}

/* Identity Card */
.identity-card {
  margin-top: 0;
}

.identity-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.identity-status {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.identity-status.verified {
  background-color: #e8f5e9;
  color: #2e7d32;
}

.identity-status.unverified {
  background-color: #fff3e0;
  color: #e65100;
}

.identity-desc {
  font-size: 24rpx;
  color: #888;
}

/* Reliability Card */
.trust-score-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 24rpx;
}

.trust-score-circle {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.trust-score-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
}

.trust-score-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.trust-rates {
  display: flex;
  flex: 1;
  justify-content: space-around;
}

.rate-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.rate-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.rate-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

/* Badges */
.badges-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f5;
}

.badge-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: #f8f9ff;
  padding: 10rpx 20rpx;
  border-radius: 28rpx;
}

.badge-icon {
  font-size: 28rpx;
}

.badge-name {
  font-size: 22rpx;
  color: #555;
}

/* Signals */
.signals-list {
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f5;
}

.signal-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.signal-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-green {
  background-color: #4caf50;
}

.dot-orange {
  background-color: #ff9800;
}

.signal-text {
  font-size: 24rpx;
  color: #666;
}

/* AI Profile Card */
.ai-summary {
  margin-bottom: 24rpx;
}

.ai-summary-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}

.ai-section {
  margin-bottom: 24rpx;
}

.ai-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-chip {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.ai-tag {
  background-color: #ede7f6;
  color: #5e35b1;
}

.genre-tag {
  background-color: #e3f2fd;
  color: #1565c0;
}

.slot-tag {
  background-color: #e8f5e9;
  color: #2e7d32;
}

/* Strengths Grid */
.strengths-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.strength-item {
  background-color: #f1f8e9;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
}

.strength-text {
  font-size: 24rpx;
  color: #558b2f;
}

/* AI Strategy Text */
.ai-strategy-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  display: block;
}

/* Gaps */
.gaps-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.gap-item {
  font-size: 24rpx;
  color: #888;
}

/* Next Actions */
.actions-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.action-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.action-num {
  width: 36rpx;
  height: 36rpx;
  background-color: #667eea;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  line-height: 36rpx;
  text-align: center;
}

.action-text {
  font-size: 24rpx;
  color: #555;
  line-height: 1.5;
  flex: 1;
}

/* AI Feedback */
.ai-feedback-text {
  font-size: 24rpx;
  color: #888;
  display: block;
}

/* Match Rating Card */
.rating-overall {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}

.rating-overall-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #667eea;
  line-height: 1;
}

.rating-overall-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* Rating Dimensions */
.rating-dimensions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.rating-dim-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.dim-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dim-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.dim-value {
  font-size: 24rpx;
  color: #667eea;
  font-weight: 600;
}

.dim-bar {
  height: 12rpx;
  background-color: #f0f0f5;
  border-radius: 6rpx;
  overflow: hidden;
}

.dim-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea, #764ba2);
  border-radius: 6rpx;
  transition: width 0.4s ease;
}

.rating-count {
  text-align: center;
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f5;
  font-size: 24rpx;
  color: #999;
}

/* Edit Form */
.edit-card {
  border: 2rpx solid #667eea;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f6fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  background-color: #f5f6fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999;
}

/* Multi-select Tags */
.multi-select-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.select-tag {
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  background-color: #f5f6fa;
  color: #666;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.select-tag.selected {
  background-color: #ede7f6;
  color: #5e35b1;
  border-color: #5e35b1;
  font-weight: 500;
}

/* Textarea */
.textarea-wrap {
  position: relative;
}

.form-textarea {
  width: 100%;
  height: 180rpx;
  background-color: #f5f6fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #333;
  box-sizing: border-box;
  line-height: 1.6;
}

.char-counter {
  position: absolute;
  right: 16rpx;
  bottom: 12rpx;
  font-size: 22rpx;
  color: #bbb;
}

/* Save Button */
.btn-save {
  margin-top: 12rpx;
}

/* Action Buttons */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 8rpx;
  padding-bottom: 48rpx;
}

.action-buttons .btn {
  width: 100%;
}
