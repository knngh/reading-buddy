/* Chat Page Styles */

.page-chat {
  min-height: 100vh;
  background-color: #f5f6fa;
  display: flex;
  flex-direction: column;
}

.chat-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx 48rpx;
}

/* Envelope Icon */
.placeholder-icon {
  margin-bottom: 40rpx;
}

.icon-envelope {
  width: 120rpx;
  height: 100rpx;
  position: relative;
}

.envelope-body {
  width: 120rpx;
  height: 80rpx;
  background-color: #e8eaf6;
  border-radius: 8rpx;
  position: absolute;
  bottom: 0;
  border: 3rpx solid #c5cae9;
}

.envelope-flap {
  width: 0;
  height: 0;
  border-left: 60rpx solid transparent;
  border-right: 60rpx solid transparent;
  border-top: 48rpx solid #c5cae9;
  position: absolute;
  top: 0;
}

.placeholder-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 16rpx;
}

.placeholder-desc {
  font-size: 26rpx;
  color: #888;
  text-align: center;
  line-height: 1.7;
  margin-bottom: 36rpx;
}

/* Info Section */
.info-section {
  width: 100%;
  margin-bottom: 36rpx;
}

.info-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.info-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 24rpx;
  display: block;
}

.info-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-icon {
  font-size: 36rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.info-content {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.info-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.info-text {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

/* Policy Section */
.policy-section {
  width: 100%;
  margin-bottom: 48rpx;
}

.policy-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.policy-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.policy-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* Home Button */
.btn-home {
  width: 480rpx;
  margin-top: 12rpx;
}
